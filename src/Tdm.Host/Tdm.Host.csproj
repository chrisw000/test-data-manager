<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tdm</AssemblyName>
    <Description>TDM console host: run | teardown | validate | list-entities. Install as a dotnet tool: dotnet tool install Tdm.Tool.</Description>
    <!-- W1-D1: the host ships as `dotnet tool install Tdm.Tool` (command name: tdm)
         and as a container image (see Dockerfile). -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tdm</ToolCommandName>
    <PackageId>Tdm.Tool</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <!-- W5-P6: the agent-kit is the single source of truth. Embed it so the init command's
       agents flag scaffolds it into a consuming repo (README is maintenance-only, not
       shipped). The docs site renders the same files via the snippet mechanism, so kit and
       docs cannot diverge. LogicalName is normalised to forward slashes for portability. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\agent-kit\**\*" Exclude="..\..\agent-kit\README.md">
      <LogicalName>agent-kit/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tdm.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tdm.Core\Tdm.Core.csproj" />
    <ProjectReference Include="..\Tdm.EfCore\Tdm.EfCore.csproj" />
    <ProjectReference Include="..\Tdm.Plugins\Tdm.Plugins.csproj" />
    <ProjectReference Include="..\Tdm.Observability\Tdm.Observability.csproj" />
    <ProjectReference Include="..\Tdm.Policy\Tdm.Policy.csproj" />
    <ProjectReference Include="..\Tdm.Registry.Client\Tdm.Registry.Client.csproj" />
    <ProjectReference Include="..\Tdm.Lsp\Tdm.Lsp.csproj" />
    <ProjectReference Include="..\Tdm.Api\Tdm.Api.csproj" />
  </ItemGroup>

</Project>
